APP_DOMAIN=money.example.com
TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_long_random_secret
REQUIRE_TELEGRAM_INIT_DATA=true
ADMIN_TELEGRAM_IDS=123456789
ADMIN_ALERTS_ENABLED=false
ADMIN_ALERT_THROTTLE_MS=600000
ADMIN_ALERT_MAX_MESSAGE_LENGTH=900
POSTGRES_DB=money_flow
POSTGRES_USER=money_flow
POSTGRES_PASSWORD=replace_with_long_random_password
DEFAULT_MONTHLY_BUDGET=45000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
EXPENSE_FAST_PATH_MODE=off
EXPENSE_PARSER_FAST_PATH_MODE=
# Integer 0..100; fractional values are floored before routing.
EXPENSE_PARSER_LOCAL_FIRST_ROLLOUT_PERCENT=0
# Telegram user IDs for local-first allowlist, comma-separated.
EXPENSE_PARSER_LOCAL_FIRST_USER_IDS=
EXPENSE_PARSER_MAX_LOCAL_AMOUNT=1000000
EXPENSE_PARSER_LLM_TIMEOUT_MS=20000
# Required before enabling local-first routing via mode=enabled, rollout percent, or allowlist.
PARSER_TEXT_HASH_SECRET=
DEEPGRAM_API_KEY=
RATE_LIMIT_WINDOW_MS=60000
# Legacy RATE_LIMIT_MAX is still accepted by compose.prod.yml; prefer RATE_LIMIT_MAX_REQUESTS for new config.
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_BUCKET_TTL_MS=120000
RATE_LIMIT_CLEANUP_INTERVAL_MS=60000
# Current host-proxy Docker topology uses 172.18.0.1 as the API container's remoteAddress.
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.18.0.1
MAX_JSON_BYTES=256000
TELEGRAM_JOB_GLOBAL_CONCURRENCY=3
TELEGRAM_JOB_USER_QUEUE_LIMIT=2
TELEGRAM_JOB_TIMEOUT_MS=90000
RELEASE_DIGEST_AUTO_SEND_ENABLED=true
RELEASE_DIGEST_TIMEZONE=Asia/Bangkok
RELEASE_DIGEST_SEND_HOUR=21
RELEASE_DIGEST_CHECK_INTERVAL_MINUTES=15
GITHUB_TOKEN=
GITHUB_REPOSITORY=Eugenio-Minochkin/money_flow
DAILY_REMINDER_GLOBAL_ENABLED=false
DAILY_REMINDER_ROLLOUT_PERCENT=0
DAILY_REMINDER_INTERVAL_MS=600000

# --- Postgres backup / restore (see docs/deployment-runbook.md) ---
# On the server run scripts with: ENV_FILE=.env.production COMPOSE_FILE=compose.prod.yml
# BACKUP_DIR=/opt/money-flow/backups/postgres
# BACKUP_RETENTION_DAYS=14
# BACKUP_REMOTE_ENABLED=false
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=money-flow/postgres
# aws CLI reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION.
# restore-postgres.sh requires RESTORE_TARGET_DB; set RESTORE_CONFIRM_PRODUCTION=yes only for real app-DB restores.
