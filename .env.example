DATABASE_URL=postgres://money_flow:money_flow@localhost:5432/money_flow
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
MINI_APP_URL=http://localhost:3000
DEFAULT_MONTHLY_BUDGET=45000
PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Disabled by default. Accepts one Telegram JPEG/PNG image up to 10 MB.
EXPENSE_EVIDENCE_IMPORT_ENABLED=false
EXPENSE_EVIDENCE_MAX_BYTES=10485760
EXPENSE_EVIDENCE_TIMEOUT_MS=30000
EXPENSE_EVIDENCE_MODEL=
# Required in production when EXPENSE_EVIDENCE_IMPORT_ENABLED=true.
EXPENSE_EVIDENCE_HMAC_SECRET=
EXPENSE_FAST_PATH_MODE=off
EXPENSE_PARSER_FAST_PATH_MODE=
# Integer 0..100; fractional values are floored before routing.
EXPENSE_PARSER_LOCAL_FIRST_ROLLOUT_PERCENT=0
# Telegram user IDs for local-first allowlist, comma-separated.
EXPENSE_PARSER_LOCAL_FIRST_USER_IDS=
EXPENSE_PARSER_MAX_LOCAL_AMOUNT=1000000
EXPENSE_PARSER_LLM_TIMEOUT_MS=20000
# Required before enabling local-first routing via mode=enabled, rollout percent, or allowlist.
PARSER_TEXT_HASH_SECRET=
DEEPGRAM_API_KEY=
DAILY_REMINDER_GLOBAL_ENABLED=false
DAILY_REMINDER_ROLLOUT_PERCENT=0
DAILY_REMINDER_INTERVAL_MS=600000
PLANNED_PAYMENT_REMINDER_GLOBAL_ENABLED=false
PLANNED_PAYMENT_REMINDER_SEND_HOUR=21

# --- Postgres backup / restore (scripts/backup-postgres.sh, scripts/restore-postgres.sh) ---
# BACKUP_DIR=backups/postgres
# BACKUP_RETENTION_DAYS=14
# Optional S3-compatible external copy (only runs when BACKUP_REMOTE_ENABLED=true):
# BACKUP_REMOTE_ENABLED=false
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=money-flow/postgres
# aws CLI reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_BUCKET_TTL_MS=120000
RATE_LIMIT_CLEANUP_INTERVAL_MS=60000
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.18.0.1
