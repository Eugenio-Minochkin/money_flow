{
  "name": "money-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node -e \"console.log('1. docker compose up -d postgres\\n2. npm run dev:reset\\n3. npm run dev:api\\n4. open http://localhost:3000/dev')\"",
    "dev:api": "node --env-file=.env apps/api/src/server.js",
    "dev:reset": "node --env-file=.env apps/api/scripts/dev-reset.js",
    "dev:sandbox": "node -e \"console.log('Open http://localhost:3000/dev after running npm run dev:api')\"",
    "test": "node --test",
    "test:integration:postgres": "node --test apps/api/integration/postgres-smoke.js",
    "dev:miniapp": "node apps/miniapp/dev-server.cjs",
    "start:api": "node --env-file=.env apps/api/src/server.js",
    "release-note:create": "node --env-file=.env apps/api/scripts/create-release-note.js",
    "release-notes:sync-pr": "node apps/api/scripts/sync-release-notes-pr.js",
    "reports:backfill": "node --env-file=.env apps/api/scripts/backfill-report.js"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {}
}
